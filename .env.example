# Supabase project settings. Keep the service-role key on the server only.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ASSIGNMENTS_BUCKET=assignments

# Google Cloud Vision API key; restrict this key to the Vision API.
GOOGLE_VISION_API_KEY=
MAX_ASSIGNMENT_UPLOAD_MB=20

# Local development only. Supabase authentication is used when configured.
GRADEWISE_DEMO_AUTH=true
FLASK_SECRET_KEY=replace-with-a-long-random-secret
GRADEWISE_DATABASE=data/gradewise.sqlite3
